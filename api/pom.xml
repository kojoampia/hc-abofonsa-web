<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>net.jojoaddison</groupId>
  <artifactId>abofonsa-bridgecare-api</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>abofonsa-bridgecare-api</name>
  <description>Abofonsa BridgeCare Health Connect — public content API and CMS backend</description>

  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
    <jacoco.line.coverage.minimum>0.80</jacoco.line.coverage.minimum>
    <!-- Where the shipped UI bundles live relative to this module. Overridden in the Docker
         build, whose context root is the repository root. -->
    <abofonsa.i18n.dir>${project.basedir}/../web/public/i18n</abofonsa.i18n.dir>
    <!-- Ahead of what Boot 4.1.0 pins (11.0.22). The OWASP scan found five CVEs against that
         version, four of them rated 9.1 — CVE-2026-53434 (CRL handling on FFM connectors),
         CVE-2026-55276 and CVE-2026-53404 (effective web.xml logging omits security constraints),
         CVE-2026-59083 (URL hex-encoding) and CVE-2026-59084 (EncryptInterceptor configuration).
         Apache fixed the last of them in 11.0.24. Remove this override once the Boot parent
         catches up; leaving a manual pin behind is how a dependency silently goes backwards. -->
    <tomcat.version>11.0.24</tomcat.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-mongodb</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-cache</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Actuator exposes a /actuator/prometheus endpoint only when a Prometheus registry is on the
         classpath; without this the endpoint listed in application.yml simply 404s (spec §13.5). -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>
    <!-- Issues admin JWTs (the oauth2-resource-server starter above only verifies them). -->
    <dependency>
      <groupId>com.nimbusds</groupId>
      <artifactId>nimbus-jose-jwt</artifactId>
      <version>10.0.2</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-mongodb</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>2.0.5</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!-- The shipped UI translation bundles live in web/public/i18n (spec §10.7 - versioned
           with the frontend, served statically). The i18n coverage report (§9.4 T-7) needs their
           key set server-side, so they are copied onto the classpath at build time rather than
           duplicated. If web/ is absent (e.g. a standalone api Docker build), the copy is a no-op
           and I18nService degrades to an empty default key set. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-i18n-defaults</id>
            <phase>generate-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/i18n</outputDirectory>
              <resources>
                <resource>
                  <directory>${abofonsa.i18n.dir}</directory>
                  <!-- Absent in an api-only checkout: the copy no-ops and I18nService degrades
                       to an empty default key set rather than failing the build. -->
                  <includes><include>*.json</include></includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.13</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <excludes>
                    <!-- DTOs/records and the application entrypoint carry no branching logic
                         worth gating on - counting them dilutes the signal from the packages
                         that actually matter (service, web.rest, domain). -->
                    <exclude>net.jojoaddison.abofonsa.AbofonsaApp</exclude>
                    <exclude>net.jojoaddison.abofonsa.service.dto.*</exclude>
                  </excludes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.line.coverage.minimum}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.8.0</version>
        <configuration>
          <java>
            <palantirJavaFormat/>
            <removeUnusedImports/>
            <importOrder/>
          </java>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Dependency vulnerability scan (plan task 106). Kept in a profile, not the default build:
         it downloads and updates a multi-hundred-megabyte NVD mirror, which is right for CI and
         wrong for `./mvnw verify` on a laptop. Run it with `./mvnw verify -Psecurity`.

         The NVD API has required a key since late 2023 - without one the update is rate-limited to
         the point of timing out. CI passes it as NVD_API_KEY; locally the property is simply empty
         and the plugin falls back to the (slow) unauthenticated path. -->
    <profile>
      <id>security</id>
      <properties>
        <nvd.api.key/>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.owasp</groupId>
            <artifactId>dependency-check-maven</artifactId>
            <version>12.1.0</version>
            <configuration>
              <!-- Spec's threshold: anything High or worse fails the build. -->
              <failBuildOnCVSS>7</failBuildOnCVSS>
              <nvdApiKey>${nvd.api.key}</nvdApiKey>
              <!-- Each entry names one CVE against one artifact and states why it does not
                   apply; see the file for the evidence. -->
              <suppressionFiles>
                <suppressionFile>${project.basedir}/dependency-check-suppressions.xml</suppressionFile>
              </suppressionFiles>
              <!-- Test-scope CVEs cannot reach production and would otherwise block releases on
                   findings in Testcontainers' transitive tree. -->
              <skipTestScope>true</skipTestScope>
              <!-- Sonatype's OSS Index now rejects anonymous callers with a 401, which
                   dependency-check surfaces as a fatal analysis exception — so the build's outcome
                   would depend on a third party's rate limiter rather than on this project's
                   dependencies. NVD remains the data source and is the one the CVSS >= 7 gate
                   reads. Re-enable with <ossindexAnalyzerUsername>/<ossindexAnalyzerPassword> if
                   a Sonatype account is ever provisioned; it adds coverage NVD lacks. -->
              <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
              <formats>
                <format>HTML</format>
                <format>SARIF</format>
              </formats>
            </configuration>
            <executions>
              <execution>
                <phase>verify</phase>
                <goals><goal>check</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
