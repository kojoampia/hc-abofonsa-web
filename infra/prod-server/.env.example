# Template for ~/webroot/01-healthconnect/abofonsa/.env on webserver.
#
# Copy to `.env`, fill in every generated value, and `chmod 600` it — it holds the signing key for
# every admin session. It is never committed; only this template is.
#
# Generate the three secrets fresh for each environment. Do not reuse the values from staging, and
# do not reuse anything that has ever appeared in a chat log or a terminal history that syncs.

# Image source. These two are one setting in two lines — together they are the image reference —
# and anything that changes one must change the other. Both deploy channels do:
#
#   local   ./deploy.sh                   REGISTRY=docker.jojoaddison.net  TAG=<short sha>
#           builds the images on the deploying machine and pushes them there.
#   github  ./deploy.sh --channel github   REGISTRY=ghcr.io/kojoampia      TAG=<full sha>
#           and .github/workflows/release.yml deploy exactly the images GitHub Actions built.
#           The tag is the full 40-character SHA because that is what the workflow tags with.
#
# Whichever wrote this file last is what the stack pulls; there is nothing else to change to move
# between them. `latest` is a convenience for a manual deploy and should not be what production
# normally runs on, because it makes "what is deployed" unanswerable.
#
# If the GHCR packages are private, this server needs a read-only credential once:
#   echo <token> | docker login ghcr.io -u kojoampia --password-stdin
# The token needs the read:packages scope and nothing else. Public packages need no login at all.
REGISTRY=docker.jojoaddison.net
TAG=latest

# HS512 needs at least 64 bytes of key material:
#   openssl rand -base64 64 | tr -d '\n'
# Rotating this invalidates every issued access and refresh token, which logs all staff out. That
# is the correct response to a suspected leak.
JWT_SIGNING_KEY=

# The first admin password. The account is created with mustChangePassword=true, so this value is
# usable exactly once — see the go-live checklist item on rotating it.
#   openssl rand -base64 24
BOOTSTRAP_ADMIN_PASSWORD=

# Salts the hash of visitor IPs used for enquiry rate limiting, so the stored hashes cannot be
# reversed to addresses. Changing it resets every rate-limit counter.
#   openssl rand -base64 32
ENQUIRY_IP_SALT=

# Hostnames Angular's SSR engine will serve. A request whose Host is not listed is rejected
# outright, so this must match what nginx forwards.
ALLOWED_HOSTS=web.abofonsa.com

# Whether search engines may index this deployment. Opt-in on purpose: leave it false for the
# production review, and set it to true only when this is the real, announced site. A review host
# that gets indexed competes with the real launch and is slow to remove from results.
SITE_INDEXABLE=false

# Loopback port the web container publishes; nginx proxies to it. Change only if it collides with
# another app on this host (8080/8081 are already taken).
FRONTEND_PORT=8082
