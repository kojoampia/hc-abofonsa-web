{
  "//": [
    "Lighthouse CI budgets (plan task 111, spec §13.1). Run against the compose stack:",
    "  docker compose up -d --build --wait && npx lhci autorun",
    "",
    "The throttling below is Lighthouse's mobile default — a mid-tier Android on slow 4G — which is",
    "the audience this site is built for, not a desktop on office fibre. Numbers measured on an",
    "unthrottled laptop would pass trivially and mean nothing.",
    "",
    "assertions use `warn` for the aggregate category scores and `error` for the three Core Web",
    "Vitals the spec names. A category score mixes dozens of audits and moves for reasons unrelated",
    "to this change; a specific metric regressing is a real regression."
  ],
  "ci": {
    "collect": {
      "url": ["http://localhost:4000/", "http://localhost:4000/es"],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 390,
          "height": 844,
          "deviceScaleFactor": 2.625,
          "disabled": false
        },
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 1638.4,
          "cpuSlowdownMultiplier": 4,
          "requestLatencyMs": 562.5,
          "downloadThroughputKbps": 1474.56,
          "uploadThroughputKbps": 675
        }
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }],

        "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],

        "unused-javascript": ["warn", { "maxLength": 0 }],
        "modern-image-formats": ["warn", { "maxLength": 0 }],
        "uses-responsive-images": ["error", { "maxLength": 0 }],
        "unsized-images": ["error", { "maxLength": 0 }],
        "font-display": ["error", { "maxLength": 0 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./e2e/lighthouse-report"
    }
  }
}
